{
  "name": "my-app",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "git config core.hooksPath scripts/git-hooks",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "typecheck:watch": "tsc -w",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "firebase": "11.10.0",
    "firebase-admin": "^14.4.0",
    "next": "16.1.1",
    "next-intl": "^4.14.8",
    "postcss": "^8.5.26",
    "react": "19.2.3",
    "react-datepicker": "8.10.0",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.19.0",
    "eslint-config-next": "16.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jose": "5.10.0"
  }
}
